# Base URL of the LMS backend.
#
# Simulator / emulator on the same machine:
#   http://localhost:5002
#
# Physical device: localhost points at the phone, not your computer — use the
# development machine's LAN IP, and make sure both are on the same network.
#   http://192.168.1.42:5002
#
# EXPO_PUBLIC_ variables are inlined into the client bundle at build time, so
# never put a secret here.
EXPO_PUBLIC_API_URL=https://lms-backend-bc8d.onrender.com
