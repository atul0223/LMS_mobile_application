# Server
# Omit on Render — the platform injects PORT and a hardcoded value will fail
# to bind. The app falls back to 5002 locally.
PORT=5002

# --- Required: the app exits at startup if any of these are missing ---

MONGODB_URI=mongodb://localhost:27017/lms

# Use a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Transactional email (Brevo). MAIL_SENDER_EMAIL must be a sender address
# verified in your Brevo account — Brevo rejects an undefined or unverified
# sender, and OTP delivery failures are deliberately non-fatal, so a bad value
# here means signup succeeds but no code is ever delivered.
BREVO_API_KEY=
MAIL_SENDER_EMAIL=no-reply@example.com

# --- Optional: the app starts without these but warns ---

MAIL_SENDER_NAME=LMS

# Cloudinary video storage and delivery
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Token-based auth key (Cloudinary console -> Settings -> Security ->
# Token-based authentication). Without it playback URLs are signed but never
# expire, so a shared link keeps working indefinitely.
CLOUDINARY_AUTH_TOKEN_KEY=

# Comma-separated list of allowed browser origins.
# Leave empty to reflect the request origin (development only).
CORS_ORIGINS=
