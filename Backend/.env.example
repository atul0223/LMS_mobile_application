# Server
PORT=5002

# Database (required)
MONGODB_URI=mongodb://localhost:27017/lms

# Auth (required) — use a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Comma-separated list of allowed browser origins.
# Leave empty to reflect the request origin (development only).
CORS_ORIGINS=

# Transactional email (Brevo)
BREVO_API_KEY=
MAIL_SENDER_NAME=LMS
MAIL_SENDER_EMAIL=no-reply@example.com

# Cloudinary video storage and delivery
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Token-based auth key (Settings -> Security -> Token-based authentication).
# Required for playback URLs that expire; without it links are signed but permanent.
CLOUDINARY_AUTH_TOKEN_KEY=
